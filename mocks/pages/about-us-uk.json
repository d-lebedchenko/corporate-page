        {
          "id": "68fe610ab61a4620490944a2",
          "keyTasks": [
            {
              "id": "68fe613fb61a4620490944a3",
              "text": "Підтримка та вдосконалення існуючих бекенд-систем."
            },
            {
              "id": "68fe6145b61a4620490944a4",
              "text": "Розробка нових функцій і виправлення багів."
            },
            {
              "id": "68fe6148b61a4620490944a5",
              "text": "Робота з високонавантаженими системами та великими обсягами даних для забезпечення продуктивності, надійності та масштабованості."
            },
            {
              "id": "68fe614fb61a4620490944a6",
              "text": "Вирішення бізнес-задач через бекенд-розробку."
            }
