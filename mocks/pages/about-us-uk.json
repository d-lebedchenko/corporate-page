        },
        {
          "id": "68fe61ddb61a4620490944ab",
          "keyTasks": [
            {
              "id": "68fe621bb61a4620490944ac",
              "text": "Розвиток і вдосконалення QА-стратегії."
            },
            {
              "id": "68fe6222b61a4620490944ad",
              "text": "Сприяння впровадженню QA-практик у командах."
            },
            {
              "id": "68fe622fb61a4620490944ae",
              "text": "Підтримка та покращення тестової інфраструктури."
            },
            {
              "id": "68fe623ab61a4620490944af",
              "text": "Розширення та підтримка метрик якості."
            },
            {
              "id": "68fe6241b61a4620490944b0",
              "text": "Впровадження підходу shift-left."
            },
            {
              "id": "68fe6247b61a4620490944b1",
              "text": "Оцінка та тестування нових інструментів і практик."
            },
            {
              "id": "68fe624cb61a4620490944b2",
              "text": "Забезпечення масштабованості QA-процесів."
            },
            {
              "id": "68fe6251b61a4620490944b3",
              "text": "Аналіз робочих процесів і пропозиції щодо їх покращення."
            }
          ],
          "techStacks": [
            {
              "id": "68fe626eb61a4620490944b4",
