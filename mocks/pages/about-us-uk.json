          "keyTasks": [
            {
              "id": "68fe5d77709efb2089eb15a5",
              "text": "Побудова та підтримка масштабованої UI-архітектури."
            },
            {
              "id": "68fe5d69709efb2089eb15a3",
              "text": "Співпраця з командами Product, Design та Backend."
            },
            {
              "id": "68fe5da84a9519156040f647",
              "text": "Забезпечення якості коду через рев’ю та тестування."
            },
            {
              "id": "68fe5db84a9519156040f649",
              "text": "Оптимізація продуктивності, доступності та сумісності з браузерами."
            },
            {
              "id": "68fe5dc04a9519156040f64b",
              "text": "Підтримка дизайн-систем та фронтенд-документації."
            },
            {
              "id": "68fe5dc94a9519156040f64d",
              "text": "Оптимізація інструментів та процесів для комфортної роботи розробників."
            }
          ],
