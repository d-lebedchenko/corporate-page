        },
        {
          "id": "68fe6430b61a4620490944c9",
          "keyTasks": [
            {
              "id": "68fe6434b61a4620490944ca",
              "text": "Забезпечення моніторингу 24/7 та ескалація у випадку збоїв або зниження продуктивності сервісів."
            },
            {
              "id": "68fe6478b61a4620490944cb",
              "text": "Гарантія того, що всі критично важливі системи (9C) охоплені моніторингом, і постійне вдосконалення його якості."
            },
            {
              "id": "68fe647cb61a4620490944cc",
              "text": "Цілодобове відстеження стану продакшену, реагування на алерти та виконання ролі першої лінії реагування на інциденти."
            },
            {
              "id": "68fe6481b61a4620490944cd",
              "text": "Підтримка інструментів операційної діяльності: система інцидентів, документація, бази знань."
            },
            {
              "id": "68fe648fb61a4620490944ce",
              "text": "Аналіз впливу інцидентів на стабільність системи."
            }
          ],
          "techStacks": [
            {
              "id": "68fe64a8b61a4620490944cf",
              "title": "Monitoring & alerting:",
              "value": "Prometheus, Grafana, vmalert"
            },
            {
              "id": "68fe64b1b61a4620490944d0",
              "title": "Incident tracking & knowledge:",
              "value": "Compass, Betterstack"
            }
          ],
          "title": "SERVICE OPERATIONS",
          "keyTasksTitle": null,
          "techStacksTitle": null
        },
        {
          "id": "68fe6564b61a4620490944d9",
          "keyTasks": [
            {
              "id": "68fe6567b61a4620490944da",
              "text": "Надання командам інструментів і сервісів для швидшої та безпечнішої розробки."
            },
            {
              "id": "68fe65ceb61a4620490944db",
              "text": "Побудова та підтримка інфраструктурних сервісів, що використовуються всіма інженерними командами."
            },
            {
              "id": "68fe65dab61a4620490944dc",
              "text": "Підтримка та розвиток R&D-рішень."
            },
            {
              "id": "68fe65deb61a4620490944dd",
              "text": "Розробка внутрішніх платформ і self-service інструментів (для Data Science, Data Engineering та підвищення інженерної продуктивності)."
            },
            {
              "id": "68fe65e4b61a4620490944de",
              "text": "Уніфікація підходів, забезпечення безпеки та масштабованості інженерної екосистеми."
            },
            {
              "id": "68fe65ecb61a4620490944df",
              "text": "Співпраця з усіма командами для того, щоб їхні рішення було легко розгортати, масштабувати та підтримувати."
            }
          ],
