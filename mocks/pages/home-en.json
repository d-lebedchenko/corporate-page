    {
      "id": "68e77e5208675f69cf46e39f",
      "title": "Що означає",
      "titleGreen": " 10/10ths",
      "text": {
        "root": {
          "type": "root",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "10/10s — термін зі світу рейсингу, яким описують вихід авто у пік свого потенціалу, і найкращий з можливих результатів.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "TENTENS Tech — про технології, що рухають вперед: щоб виграти, потрібен максимальний темп, технічна досконалість та команда, що працює пліч-о-пліч.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            }
          ],
          "direction": null
        }
      },
