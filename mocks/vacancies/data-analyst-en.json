          "children": [
            {
              "tag": "h2",
              "type": "heading",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "Про компанію",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "Relatio – технологічна компанія, яка створює продукти для покращення романтичних стосунків. Наш додаток допомагає користувачам зі всього світу побудувати гармонійні і здорові стосунки з партнером завдяки саморозвитку.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "Ми запустили бізнес влітку 2023 року і вже досягли значного успіху – знайшли юніт економіку та активно масштабуємося до розмірів великої компанії. Кожен новий співробітник зараз має можливість стати лідером свого напряму, все залежить лише від твоєї ініціативи та амбіцій.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "Зараз ми в пошуку ",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                },
                {
                  "mode": "normal",
                  "text": "Junior+/Middle Business Analyst.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 1,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            }
          ],
          "direction": null
        }
      }
    },
    {
      "id": "691c87072955b400232a10a9",
      "biggerMarginBottom": null,
      "content": {
        "root": {
          "type": "root",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "tag": "h2",
              "type": "heading",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "Роль ІТ-експертів у процесі трансформації",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null
            },
            {
              "tag": "h3",
              "type": "heading",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "Які виклики чекають:",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null
            },
            {
              "tag": "ul",
              "type": "list",
              "start": 1,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "type": "listitem",
                  "value": 1,
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Взаємодія з ключовими користувачами, замовниками та командою розробки для збору, формалізації та уточнення бізнес-вимог;",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": null
                },
                {
                  "type": "listitem",
                  "value": 2,
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Переклад вимог у user stories, технічні завдання та іншу проєктну документацію;",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": null
                },
                {
                  "type": "listitem",
                  "value": 3,
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Підтримка процесу розробки: супровід реалізації задач, участь у плануваннях та демо;",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": null
                },
                {
                  "type": "listitem",
                  "value": 4,
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Контроль якості впровадження функціональності — від ідеї до продакшну;",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": null
                },
                {
                  "type": "listitem",
                  "value": 5,
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Пошук можливостей для покращення користувацького досвіду та ефективності процесів;",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": null
                },
                {
                  "type": "listitem",
                  "value": 6,
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Залучення до роботи над мобільним додатком та інтеграціями з внутрішніми і зовнішніми сервісами.",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": null
                }
              ],
              "listType": "bullet",
              "direction": null
            }
          ],
          "direction": null
        }
      }
    },
    {
