              "children": [
                {
                  "type": "listitem",
                  "value": 1,
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Здатність до швидкого навчання та бажання розвиватися;",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": null
                },
                {
                  "type": "listitem",
                  "value": 2,
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Досвід у зборі, описі та верифікації вимог (user stories, acceptance criteria, технічна документація);",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": null
                },
                {
                  "type": "listitem",
                  "value": 3,
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Вміння бачити як загальну картину, так і розбиратися в деталях;",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": null
                },
                {
                  "type": "listitem",
                  "value": 4,
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Розуміння принципів роботи мобільних додатків та інтеграцій через API;",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": null
                },
                {
                  "type": "listitem",
                  "value": 5,
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Впевнене володіння інструментами: Jira, Confluence, Postman, базові знання SQL, JSON.",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": null
                }
              ],
              "listType": "bullet",
              "direction": null
            }
          ],
          "direction": null
        }
