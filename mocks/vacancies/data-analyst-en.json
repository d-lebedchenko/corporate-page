                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Досвід роботи з аналітичними системами (Power BI або подібні);",
                      "type": "text",
                      "style": "",
                      "detail": 0,
                      "format": 0,
                      "version": 1
                    }
                  ],
                  "direction": null
                },
                {
                  "type": "listitem",
                  "value": 3,
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "children": [
                    {
                      "mode": "normal",
                      "text": "Досвід участі у проектах з використанням AI-рішень (чат-боти, аналітика);",
                      "type": "text",
                      "style": "",
                      "detail": 0,
